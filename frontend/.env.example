# KisanVault Frontend Environment Variables

# The base URL of the FastAPI backend.
# In production, this should point to the real deployed backend.
# In local development, the Next.js frontend defaults to http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---------------------------------------------------------
# DEVELOPMENT DEMO MODE
# ---------------------------------------------------------
# This variable controls whether the frontend exposes a "Use Demo Account" 
# button for UI/UX inspection when the backend is unavailable.
# 
# IMPORTANT:
# - Set to "false" (or omit) in production.
# - Do NOT commit `.env.local` to version control.
# - Developers can create `.env.local` with `NEXT_PUBLIC_DEMO_MODE=true` 
#   for local frontend-only testing.
NEXT_PUBLIC_DEMO_MODE=false
